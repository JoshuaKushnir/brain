      {
        "name": "Shortlisted",
        "link": true,
        "defaultViewMode": "Small Cards",
        "defaultViewOrder": "AliasOrFilename",
        "defaultViewPriorityVisibility": true,
        "defaultViewPriorityGrouping": true
      },
      {
        "name": "Drafting",
        "link": true,
        "defaultViewMode": "Detailed Cards",
        "defaultViewOrder": "AliasOrFilename",
        "defaultViewPriorityVisibility": true,
        "defaultViewPriorityGrouping": true
      },
      {
        "name": "Focus",
        "link": true,
        "defaultViewMode": "Simple Cards",
        "defaultViewOrder": "AliasOrFilename",
        "defaultViewPriorityVisibility": true,
        "defaultViewPriorityGrouping": true
